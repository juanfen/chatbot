VITE_APP_TITLE=ChatBot Admin

VITE_BASE_URL=/
VITE_ROUTER_HISTORY_MODE=history
VITE_ROUTE_HOME=home

# auth route mode: static | dynamic
VITE_AUTH_ROUTE_MODE=dynamic
VITE_STATIC_SUPER_ROLE=super

VITE_STORAGE_PREFIX=chatbot__

VITE_MENU_ICON=mdi:menu
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_ICONIFY_URL=https://api.iconify.design

# VITE_SERVICE_BASE_URL=http://192.168.99.102:8088
VITE_SERVICE_BASE_URL=http://127.0.0.1:8088
# VITE_OTHER_SERVICE_BASE_URL={"http://192.168.99.102:8088"}
VITE_OTHER_SERVICE_BASE_URL={"http://127.0.0.1:8088"}
VITE_SERVICE_SUCCESS_CODE=0

VITE_DEVTOOLS_LAUNCH_EDITOR=cursor
VITE_AUTOMATICALLY_DETECT_UPDATE=Y
VITE_SOURCE_MAP=N
