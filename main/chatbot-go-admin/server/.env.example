# chatbot-go-admin / server 环境变量示例
#
# 用法：
#   1. 复制为 .env：cp .env.example .env
#   2. 按需修改下方值；.env 不会被提交到 Git（已在 .gitignore 中）。
#   3. 进程已存在的真实环境变量优先级更高，命令行 export 会覆盖 .env 中的同名项。
#
# 也可通过 ADMIN_DOTENV_PATH 显式指定 .env 文件位置。

# === HTTP / 鉴权 ===
ADMIN_HTTP_ADDR=:8088
ADMIN_LOG_LEVEL=info
ADMIN_JWT_SECRET=dev-secret-change-me
ADMIN_SCHEMA_DIR=resources/schema
# 本机前端直连远程 API 时的 CORS（逗号分隔 Origin）；留空则仅允许 localhost/127.0.0.1
# ADMIN_CORS_ORIGINS=http://localhost:9527,http://127.0.0.1:9527

# === SV 声纹服务（分配音色时注册声纹）===
# 注册接口：multipart 字段 speaker_id + file（不是 identify 的 speaker_ids）
SV_VOICEPRINT_REGISTER_URL=http://192.168.99.103:8006/voiceprint/register
# 若仅配置下方 identify 地址，会自动替换为 /voiceprint/register
# SV_VOICEPRINT_IDENTIFY_URL=http://192.168.99.103:8006/voiceprint/identify
SV_VOICEPRINT_TOKEN=ef7871c4-d705-4202-8cab-3b816b7f9ee8
SV_VOICEPRINT_TIMEOUT_SEC=120

# === 长期记忆画像服务（保存音色个性化内容时同步 import_basic_info）===
MEMORY_PROFILE_BASE_URL=http://192.168.99.103:8176
MEMORY_PROFILE_TIMEOUT_SEC=30

# === 算法运行时配置反向代理目标（xiaozhi-go-core 的 Gateway HTTP）===
# 用于「算法运行时配置」管理界面把请求转发到 xiaozhi-go-core /xiaozhi/v1/runtime/config
XIAOZHI_CORE_BASE_URL=http://127.0.0.1:8003

# === 移动端语音样本（上传后转 24kHz WAV 的落盘目录）===
# 相对路径相对于进程工作目录；生产环境建议绝对路径，并保证目录可写
ADMIN_AUDIO_TARGET_PATH=data/audio
# 上传转码时做人声降噪（ffmpeg afftdn 等）；设为 false 则仅重采样转 WAV
ADMIN_AUDIO_DENOISE=true
# ADMIN_FFMPEG_BIN=ffmpeg
# ADMIN_FFPROBE_BIN=ffprobe

# === PostgreSQL ===
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=postgres
PG_SSLMODE=disable
